  private int toDays(final String s) {
    final int month = (s.charAt(0) - '0') * 10 + (s.charAt(1) - '0');
    final int day = (s.charAt(3) - '0') * 10 + (s.charAt(4) - '0');
    int prevDays = 0;
    for (int m = 1; m < month; ++m)
      prevDays += days[m];
    return prevDays + day;
  }
